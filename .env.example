# Local development is fully offline after installing dependencies.
FORECAST_BACKEND=local
HOST=127.0.0.1
PORT=8000

# Required for submission: switch to quickml AFTER configuring and testing Zoho.
QUICKML_ENDPOINT_URL=https://api.catalyst.zoho.in/quickml/v1/project/89751000000013051/endpoints/predict
QUICKML_ENDPOINT_KEY=
QUICKML_ORG_ID=60093489724
QUICKML_ENVIRONMENT=Development
QUICKML_FEATURE_MODE=engineered

# Match the published endpoint's sample request and response EXACTLY.
# This project's endpoint accepts {"data":{features}} and returns {"result":[123.4]}.
# If your endpoint supports {"data":[rows]} and {"predictions":[numbers]}, use
# REQUEST_MODE=batch, REQUEST_KEY=data, RESPONSE_PATH=predictions instead.
QUICKML_REQUEST_MODE=single
QUICKML_REQUEST_KEY=data
QUICKML_RESPONSE_PATH=result
QUICKML_BATCH_SIZE=24
QUICKML_TIMEOUT_SECONDS=60
QUICKML_MAX_WORKERS=4

# Access token for a short local test (expires). Never commit real credentials.
QUICKML_ACCESS_TOKEN=
# For a lasting deployment, configure refresh credentials and correct region.
QUICKML_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
